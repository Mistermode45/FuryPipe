# Normalize end-of-line handling across the repository.
# Without this file, cloning on Windows with core.autocrlf=true rewrites the
# shell scripts with CRLF and bash fails with: "$'\r': command not found".
# eol=lf keeps every text file LF in the working tree on every OS, so the
# npm tarball is content-identical whether it is packed on Windows, macOS or
# Linux. With plain text=auto, a Windows autocrlf checkout shipped CRLF in the
# packaged docs, LICENSE, package.json and HTML/JS template strings bundled
# into dist/, producing a different tarball digest from the same commit.
* text=auto eol=lf

# Files that MUST stay LF even on Windows.
# - .sh/.bash are executed by bash, which chokes on a trailing \r.
# - .js/.mjs/.cjs/.py carry `#!/usr/bin/env ...` lines (bin/cli.js,
#   scripts/*.mjs, eval helpers). A CR there breaks the interpreter lookup on
#   Unix and survives Vite's shebang stripping on Windows, so importing those
#   files from a test blows up with "Invalid or unexpected token".
*.sh text eol=lf
*.bash text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf

# Binary files: no conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
