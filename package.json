  "scripts": {
    "audit": "pnpm audit --prod --audit-level high",
    "build": "node scripts/build.mjs",
    "build:atlas": "tsx scripts/gen-atlas.ts",
    "dev:node": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "browser:qa": "tsx scripts/cross-browser-qa.ts",
    "openclaw:probe": "tsx scripts/openclaw-live-probe.ts",
    "hosted-mcp:fixture": "tsx scripts/hosted-mcp-fixture.ts",
    "hosted-mcp:conformance": "tsx scripts/hosted-mcp-conformance.ts",
    "restart": "node scripts/restart.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hosted-mcp.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:smoke": "node scripts/package-smoke.mjs && node scripts/benchmark-claim-package-smoke.mjs && node scripts/provider-attempt-package-smoke.mjs && node scripts/governed-provider-package-smoke.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "vendor:ui": "node scripts/vendor-ui.mjs"
  },
