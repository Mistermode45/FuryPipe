{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mistermode45/FuryPipe/bench/v5/result.schema.json",
  "title": "FuryPipe V5 benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "variant",
    "source",
    "provider",
    "model",
    "fixture",
    "prompt",
    "toolset",
    "context",
    "cache_state",
    "metrics",
    "quality",
    "exactness",
    "recovery"
  ],
  "properties": {
    "schema_version": { "const": "furypipe-benchmark/v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": {
      "enum": ["BENCHMARK_NON_EXECUTED", "EXECUTED", "INVALID", "FAILED"]
    },
    "variant": { "enum": ["raw", "pxpipe", "furypipe"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "fixture": { "$ref": "#/$defs/digestIdentity" },
    "prompt": { "$ref": "#/$defs/digestIdentity" },
    "toolset": { "$ref": "#/$defs/digestIdentity" },
    "context": { "$ref": "#/$defs/digestIdentity" },
    "cache_state": { "enum": ["cold", "warm", "disabled"] },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "vision_tokens",
        "latency_ms",
        "ttft_ms",
        "local_transform_ms",
        "request_bytes",
        "response_bytes",
        "cost_usd",
        "errors"
      ],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "vision_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
        "local_transform_ms": { "type": ["number", "null"], "minimum": 0 },
        "request_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "response_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score"],
      "properties": {
        "status": { "enum": ["NOT_SCORED", "SCORED"] },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "exactness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "passed", "mismatches"],
      "properties": {
        "checked": { "type": "boolean" },
        "passed": { "type": ["boolean", "null"] },
        "mismatches": { "type": "integer", "minimum": 0 }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handles", "verified"],
      "properties": {
        "handles": { "type": "integer", "minimum": 0 },
        "verified": { "type": ["boolean", "null"] }
      }
    }
  },
  "$defs": {
    "digestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
